<!doctype html>
<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  data-scheme="{{ settings.color_scheme }}"
  dir="{% render '_page_direction' %}"
>
  <head>
    {% if template contains 'search' or template contains 'product' or template contains 'collection' or template contains 'compatibility' or template contains 'page.referral' %}
    <meta name="robots" content="noindex,noimageindex">
    {% endif %}


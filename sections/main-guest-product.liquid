<div class="page-width" style="text-align: center; padding: 80px 20px; max-width: 800px; margin: 0 auto;">
  <h1 style="margin-bottom: 20px;">{{ product.title }}</h1>
  
  <p style="margin-bottom: 30px; font-size: 16px; line-height: 1.5;">
    Due to TGA regulations, clinical details and pricing for this product can only be viewed by registered patients.
  </p>
  
  <a href="/account/login" class="button" style="display: inline-block; padding: 12px 24px; background-color: #000; color: #fff; text-decoration: none; border-radius: 4px;">
    Log In or Start Assessment
  </a>
</div>

{% schema %}
{
  "name": "Guest Product View",
  "settings": []
}
{% endschema %}
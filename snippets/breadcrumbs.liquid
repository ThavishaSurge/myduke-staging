<div class="{% if without_container %}{% else %}container{% endif %}{% if class %} {{ class }}{% endif %}{% if product_desktop_absolute %} absolute{% endif %}">
  <nav
    id="breadcrumbs"
    class="breadcrumb background"
    role="navigation"
    aria-label="breadcrumbs"
    {% if without_paddings -%}
      style="padding: 0;"
    {%- endif %}
  >
    {% unless template contains 'product' %}
      <a href="{{ routes.root_url }}" title="{{ 'general.breadcrumbs.home' | t }}" class="focus-inset">
        {{- 'general.breadcrumbs.home' | t -}}
      </a>
    {% endunless %}
    {% if template contains 'page' %}
      <div class="breadcrumb__delimiter ">{% render 'icon-breadcrumbs' %}</div>
      <span>{{ page.title }}</span>
    {% elsif template == 'cart' %}
      <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
      <span>{{ 'general.breadcrumbs.cart' | t }}</span>
    {% elsif template == 'article' %}
      <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
      <a href="{{ blog.url }}" class="focus-inset">{{ blog.title }}</a>
      <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
      <span>{{ page_title }}</span>
    {% elsif template contains 'product' %}
      <a href="/pages/shop-all" class="focus-inset js-breadcrumb-all-products">All products</a>
      <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
      <span>{{ product.title }} </span>
    {% elsif template == 'blog' %}
      <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
      {% if current_tags %}
        {{ blog.title | link_to: blog.url }}
        <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
        <span>{{ current_tags | join: ' + ' }} </span>
      {% else %}
        <span>{{ blog.title }}</span>
      {% endif %}
    {% elsif template == 'customers/order' %}
      <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
      <a href="{{ routes.account_url }}" class="focus-inset">{{- 'general.breadcrumbs.account' | t -}}</a>
      <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
      <span>
        {{- 'general.breadcrumbs.order' | t }}
        {{ order.name }}
      </span>
    {% elsif template == 'customers/addresses' %}
      <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
      <a href="{{ routes.account_url }}" class="focus-inset">{{- 'general.breadcrumbs.account' | t -}}</a>
      <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
      <span>{{ 'general.breadcrumbs.addresses' | t }} </span>
    {% elsif template == 'search' %}
      <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
      {% if search.performed %}
        <span>{{ 'general.breadcrumbs.search_results' | t }} </span>
      {% else %}
        <span>{{ page_title }} </span>
      {% endif %}
    {% else %}
      <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
      <span>{{ page_title }} </span>
    {% endif %}
  </nav>

  <script>
    const calcBreadcrumbs = () => {
      const breadcrumbs = document.querySelector('.breadcrumb');
      if (breadcrumbs) {
        const breadcrumbsObserver = new ResizeObserver((entries) => {
          entries.forEach((entry) => {
            const breadcrumbsHeight = breadcrumbs.getBoundingClientRect().height.toFixed(2);
            document.documentElement.style.setProperty('--breadcrumbs-height', `${breadcrumbsHeight}px`);
          });
        });
        breadcrumbsObserver.observe(breadcrumbs);
      }
    };
    calcBreadcrumbs();

    document.addEventListener('shopify:section:load', function () {
      calcBreadcrumbs();
    });

    (function () {
      var allProductsLink = document.querySelector('.js-breadcrumb-all-products');
      if (!allProductsLink) return;

      var filterTitleMap = {};
      {%- if product -%}
        {%- for collection in product.collections -%}
          filterTitleMap[{{ collection.handle | json }}] = {{ collection.title | json }};
        {%- endfor -%}
        {%- if product.type != blank -%}
          filterTitleMap[{{ product.type | handleize | json }}] = {{ product.type | json }};
        {%- endif -%}
        {%- if product.vendor != blank -%}
          filterTitleMap[{{ product.vendor | handleize | json }}] = {{ product.vendor | json }};
        {%- endif -%}
        {%- for tag in product.tags -%}
          filterTitleMap[{{ tag | handleize | json }}] = {{ tag | json }};
        {%- endfor -%}
      {%- endif -%}

      try {
        var referrer = document.referrer;
        var referrerUrl = referrer ? new URL(referrer) : null;
        if (referrerUrl && referrerUrl.pathname === '/pages/shop-all') {
          var params = new URLSearchParams(referrerUrl.search);
          var allowedFilters = ['type', 'brand', 'device'];
          var activeFilters = [];
          
          allowedFilters.forEach(function(filter) {
            var values = params.getAll(filter);
            values.forEach(function(val) {
              if (val) {
                val.split(',').forEach(function(v) {
                  if (v.trim()) activeFilters.push(v.trim());
                });
              }
            });
          });
          
          if (activeFilters.length > 0) {
            allProductsLink.href = '/pages/shop-all';
            var existingDelimiter = allProductsLink.nextElementSibling;
            
            activeFilters.forEach(function(filterValue) {
              var formattedTitle = filterTitleMap[filterValue];
              if (!formattedTitle) {
                formattedTitle = filterValue.replace(/-/g, ' ');
                formattedTitle = formattedTitle.charAt(0).toUpperCase() + formattedTitle.slice(1);
              }
              
              var newDelimiter = existingDelimiter.cloneNode(true);
              
              var filterLink = document.createElement('a');
              filterLink.href = referrerUrl.pathname + referrerUrl.search;
              filterLink.className = 'focus-inset js-breadcrumb-filter';
              filterLink.textContent = formattedTitle;
              
              allProductsLink.parentNode.insertBefore(newDelimiter, existingDelimiter);
              allProductsLink.parentNode.insertBefore(filterLink, existingDelimiter);
            });
          } else {
            allProductsLink.href = referrerUrl.pathname + referrerUrl.search;
          }
        }
      } catch (e) {}
    })();
  </script>
</div>

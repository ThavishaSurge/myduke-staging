{% doc %}
  @prompt
    FREE PRODUCT POP UP
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-free-gift-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-free-gift-{{ ai_gen_id }}__dialog {
    width: min(90vw, 520px);
    max-width: 520px;
    padding: 0;
    border: 0;
    border-radius: {{ block.settings.corner_radius }}px;
    color: #264653;
    background: #fff;
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.24);
  }

  .ai-free-gift-{{ ai_gen_id }}__dialog::backdrop {
    background: rgba(12, 12, 12, 0.62);
  }

  .ai-free-gift-{{ ai_gen_id }}__panel {
    position: relative;
    padding: 34px;
    text-align: center;
  }

  .ai-free-gift-{{ ai_gen_id }}__close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    border: 1px solid #e0dacf;
    border-radius: 50%;
    background: #fff;
    color: #264653;
    cursor: pointer;
    font-size: 24px;
    line-height: 1;
  }

  .ai-free-gift-{{ ai_gen_id }}__image-wrap {
    width: 100%;
    max-width: 190px;
    aspect-ratio: 1;
    margin: 0 auto 20px;
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
    background: #f7f8f8;
  }

  .ai-free-gift-{{ ai_gen_id }}__image-wrap img,
  .ai-free-gift-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-free-gift-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 8px;
    color: #1b625f;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ai-free-gift-{{ ai_gen_id }}__title {
    margin: 0 0 12px;
    color: #264653;
    font-size: clamp(24px, 5vw, 34px);
    line-height: 1.15;
  }

  .ai-free-gift-{{ ai_gen_id }}__copy {
    margin: 0 auto 22px;
    max-width: 390px;
    color: #2b2b2e;
    font-size: 16px;
    line-height: 1.5;
  }

  .ai-free-gift-{{ ai_gen_id }}__product-name {
    margin: -10px 0 20px;
    color: #264653;
    font-weight: 700;
  }

  .ai-free-gift-{{ ai_gen_id }}__cta {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 12px 22px;
    border: 0;
    border-radius: {{ block.settings.corner_radius }}px;
    background: #218380;
    color: #fff;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .ai-free-gift-{{ ai_gen_id }}__cta:hover {
    background: #264653;
    color: #fff;
  }

  .ai-free-gift-{{ ai_gen_id }}__cta:focus-visible,
  .ai-free-gift-{{ ai_gen_id }}__close:focus-visible {
    outline: 3px solid #1b625f;
    outline-offset: 3px;
  }

  .ai-free-gift-{{ ai_gen_id }}__fine-print {
    margin: 14px 0 0;
    color: #4b5558;
    font-size: 13px;
    line-height: 1.45;
  }

  @media screen and (max-width: 549px) {
    .ai-free-gift-{{ ai_gen_id }}__panel {
      padding: 48px 22px 26px;
    }
    .ai-free-gift-{{ ai_gen_id }}__image-wrap {
      max-width: 150px;
    }
  }
{% endstyle %}

<free-gift-popup-{{ ai_gen_id }}
  class="ai-free-gift-{{ ai_gen_id }}"
  style="width: {{ block.settings.desktop_width_percent }}%;"
  data-delay="{{ block.settings.delay_seconds }}"
  data-frequency="{{ block.settings.frequency }}"
  data-editor="{{ request.design_mode }}"
  {{ block.shopify_attributes }}
>
  <dialog class="ai-free-gift-{{ ai_gen_id }}__dialog" aria-labelledby="ai-free-gift-title-{{ ai_gen_id }}">
    <div class="ai-free-gift-{{ ai_gen_id }}__panel">
      <button class="ai-free-gift-{{ ai_gen_id }}__close" type="button" aria-label="Close popup">×</button>
      {% if block.settings.featured_product != blank %}
        <div class="ai-free-gift-{{ ai_gen_id }}__image-wrap">
          {% if block.settings.featured_product.featured_image %}
            <img src="{{ block.settings.featured_product.featured_image | image_url: width: 500 }}" alt="{{ block.settings.featured_product.featured_image.alt | default: block.settings.featured_product.title | escape }}" loading="lazy" width="500" height="500">
          {% else %}
            {{ 'product-apparel-1' | placeholder_svg_tag }}
          {% endif %}
        </div>
      {% endif %}
      {% if block.settings.eyebrow != blank %}<p class="ai-free-gift-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      <h2 class="ai-free-gift-{{ ai_gen_id }}__title" id="ai-free-gift-title-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
      {% if block.settings.message != blank %}<div class="ai-free-gift-{{ ai_gen_id }}__copy">{{ block.settings.message | escape | newline_to_br }}</div>{% endif %}
      {% if block.settings.featured_product != blank %}<p class="ai-free-gift-{{ ai_gen_id }}__product-name">{{ block.settings.featured_product.title | escape }}</p>{% endif %}
      {% assign gift_link = block.settings.button_link %}
      {% if gift_link == blank and block.settings.featured_product != blank %}{% assign gift_link = block.settings.featured_product.url %}{% endif %}
      {% if gift_link != blank %}
        <a class="ai-free-gift-{{ ai_gen_id }}__cta" href="{{ gift_link }}">{{ block.settings.button_label | escape }}</a>
      {% else %}
        <button class="ai-free-gift-{{ ai_gen_id }}__cta" type="button" data-close-popup>{{ block.settings.button_label | escape }}</button>
      {% endif %}
      {% if block.settings.fine_print != blank %}<p class="ai-free-gift-{{ ai_gen_id }}__fine-print">{{ block.settings.fine_print | escape }}</p>{% endif %}
    </div>
  </dialog>
</free-gift-popup-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'free-gift-popup-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class FreeGiftPopup extends HTMLElement {
      connectedCallback() {
        this.dialog = this.querySelector('dialog');
        this.closeButton = this.querySelector('.ai-free-gift-{{ ai_gen_id }}__close');
        this.storageKey = 'ai-free-gift-dismissed-{{ ai_gen_id }}';
        this.closeButton.addEventListener('click', () => this.close());
        this.dialog.addEventListener('click', (event) => {
          if (event.target === this.dialog) this.close();
        });
        const cta = this.querySelector('[data-close-popup]');
        if (cta) cta.addEventListener('click', () => this.close());
        if (this.dataset.editor === 'true') {
          this.dialog.showModal();
          return;
        }
        if (this.dataset.frequency === 'session' && sessionStorage.getItem(this.storageKey)) return;
        const delay = Math.max(0, Number(this.dataset.delay) || 0) * 1000;
        window.setTimeout(() => {
          if (this.isConnected && !this.dialog.open) this.dialog.showModal();
        }, delay);
      }
      close() {
        if (this.dialog.open) this.dialog.close();
        if (this.dataset.frequency === 'session') sessionStorage.setItem(this.storageKey, 'true');
      }
    }
    customElements.define(tagName, FreeGiftPopup);
  })();
</script>

{% schema %}
{
  "name": "Free gift popup",
  "settings": [
    { "type": "header", "content": "Popup content" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "A special treat" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Enjoy a free gift" },
    { "type": "textarea", "id": "message", "label": "Message", "default": "Choose your gift and see the product page for details and any eligibility requirements." },
    { "type": "product", "id": "featured_product", "label": "Gift product" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View your gift" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "fine_print", "label": "Additional details", "default": "Gift availability and eligibility may vary." },
    { "type": "header", "content": "Display" },
    { "type": "range", "id": "delay_seconds", "label": "Show after", "min": 1, "max": 30, "step": 1, "unit": "s", "default": 5 },
    { "type": "select", "id": "frequency", "label": "Show frequency", "options": [{ "value": "visit", "label": "Every visit" }, { "value": "session", "label": "Once per session" }], "default": "session" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 20, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Free gift popup" }],
  "tag": null,
  "class": "free-gift-popup-block"
}
{% endschema %}
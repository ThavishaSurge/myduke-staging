{% doc %}
  @prompt
    free product pop uip
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-free-product-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #264653;
    font-family: inherit;
  }

  .ai-free-product-{{ ai_gen_id }}__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 24px;
    border: 0;
    border-radius: {{ block.settings.button_radius }}px;
    background: #218380;
    color: #ffffff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .ai-free-product-{{ ai_gen_id }}__trigger:hover {
    background: #176d6a;
  }

  .ai-free-product-{{ ai_gen_id }}__trigger:focus-visible,
  .ai-free-product-{{ ai_gen_id }}__close:focus-visible,
  .ai-free-product-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid #264653;
    outline-offset: 3px;
  }

  .ai-free-product-{{ ai_gen_id }}__overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(12, 12, 12, 0.62);
  }

  .ai-free-product-{{ ai_gen_id }}__overlay.is-open {
    display: flex;
  }

  .ai-free-product-{{ ai_gen_id }}__dialog {
    position: relative;
    width: 100%;
    max-width: 520px;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
    padding: 36px;
    border-radius: 8px;
    background: #ffffff;
    color: #264653;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.22);
  }

  .ai-free-product-{{ ai_gen_id }}__close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #264653;
    font-size: 26px;
    cursor: pointer;
  }

  .ai-free-product-{{ ai_gen_id }}__image-wrap {
    margin: -36px -36px 24px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f7f8f8;
  }

  .ai-free-product-{{ ai_gen_id }}__image-wrap img,
  .ai-free-product-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-free-product-{{ ai_gen_id }}__heading {
    margin: 0 42px 10px 0;
    color: #264653;
    font-size: 26px;
    line-height: 1.2;
  }

  .ai-free-product-{{ ai_gen_id }}__copy {
    margin: 0 0 22px;
    color: #264653;
    line-height: 1.5;
  }

  .ai-free-product-{{ ai_gen_id }}__product {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 22px;
    padding: 14px;
    border: 1px solid #e0dacf;
    border-radius: 6px;
  }

  .ai-free-product-{{ ai_gen_id }}__product-image {
    width: 72px;
    height: 72px;
    flex: 0 0 72px;
    object-fit: cover;
    border-radius: 4px;
  }

  .ai-free-product-{{ ai_gen_id }}__product-title {
    margin: 0 0 5px;
    color: #264653;
    font-weight: 700;
  }

  .ai-free-product-{{ ai_gen_id }}__price {
    color: #264653;
    font-weight: 700;
  }

  .ai-free-product-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 22px;
    border-radius: {{ block.settings.button_radius }}px;
    background: #218380;
    color: #ffffff;
    font-weight: 600;
    text-decoration: none;
  }

  .ai-free-product-{{ ai_gen_id }}__link:hover {
    background: #176d6a;
  }

  @media screen and (max-width: 600px) {
    .ai-free-product-{{ ai_gen_id }}__dialog {
      padding: 28px 22px;
    }

    .ai-free-product-{{ ai_gen_id }}__image-wrap {
      margin: -28px -22px 22px;
    }

    .ai-free-product-{{ ai_gen_id }}__heading {
      font-size: 22px;
    }
  }
{% endstyle %}

<free-product-popup-{{ ai_gen_id }} class="ai-free-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <button type="button" class="ai-free-product-{{ ai_gen_id }}__trigger" aria-haspopup="dialog" aria-expanded="false">
    {{ block.settings.trigger_label | escape }}
  </button>
  <div class="ai-free-product-{{ ai_gen_id }}__overlay" hidden>
    <div class="ai-free-product-{{ ai_gen_id }}__dialog" role="dialog" aria-modal="true" aria-label="{{ block.settings.heading | escape }}" tabindex="-1">
      <button type="button" class="ai-free-product-{{ ai_gen_id }}__close" aria-label="Close dialog">&times;</button>
      {% if block.settings.image != blank %}
        <div class="ai-free-product-{{ ai_gen_id }}__image-wrap">
          <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
        </div>
      {% endif %}
      <h2 class="ai-free-product-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      <div class="ai-free-product-{{ ai_gen_id }}__copy">{{ block.settings.message | escape | newline_to_br }}</div>
      {% if block.settings.product != blank %}
        <div class="ai-free-product-{{ ai_gen_id }}__product">
          {% if block.settings.product.featured_image != blank %}
            <img class="ai-free-product-{{ ai_gen_id }}__product-image" src="{{ block.settings.product.featured_image | image_url: width: 160 }}" alt="{{ block.settings.product.featured_image.alt | escape }}" loading="lazy" width="72" height="72">
          {% endif %}
          <div>
            <p class="ai-free-product-{{ ai_gen_id }}__product-title">{{ block.settings.product.title | escape }}</p>
            <span class="ai-free-product-{{ ai_gen_id }}__price">{{ block.settings.product.price | money }}</span>
          </div>
        </div>
        <a class="ai-free-product-{{ ai_gen_id }}__link" href="{{ block.settings.product.url }}">{{ block.settings.link_label | escape }}</a>
      {% elsif request.design_mode %}
        <p class="ai-free-product-{{ ai_gen_id }}__copy">Choose a product in the block settings to show it here.</p>
      {% endif %}
    </div>
  </div>
</free-product-popup-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'free-product-popup-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;

    class FreeProductPopup extends HTMLElement {
      connectedCallback() {
        this.trigger = this.querySelector('.ai-free-product-{{ ai_gen_id }}__trigger');
        this.overlay = this.querySelector('.ai-free-product-{{ ai_gen_id }}__overlay');
        this.dialog = this.querySelector('.ai-free-product-{{ ai_gen_id }}__dialog');
        this.closeButton = this.querySelector('.ai-free-product-{{ ai_gen_id }}__close');
        this.onKeydown = this.handleKeydown.bind(this);
        this.trigger.addEventListener('click', () => this.open());
        this.closeButton.addEventListener('click', () => this.close());
        this.overlay.addEventListener('click', (event) => {
          if (event.target === this.overlay) this.close();
        });
      }

      open() {
        this.previousFocus = document.activeElement;
        this.overlay.hidden = false;
        this.overlay.classList.add('is-open');
        this.trigger.setAttribute('aria-expanded', 'true');
        document.addEventListener('keydown', this.onKeydown);
        this.dialog.focus();
      }

      close() {
        this.overlay.classList.remove('is-open');
        this.overlay.hidden = true;
        this.trigger.setAttribute('aria-expanded', 'false');
        document.removeEventListener('keydown', this.onKeydown);
        if (this.previousFocus) this.previousFocus.focus();
      }

      handleKeydown(event) {
        if (event.key === 'Escape') this.close();
        if (event.key === 'Tab') {
          const focusable = this.dialog.querySelectorAll('button, a[href], [tabindex]:not([tabindex="-1"])');
          if (!focusable.length) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      }
    }

    customElements.define(tagName, FreeProductPopup);
  })();
</script>

{% schema %}
{
  "name": "Free product popup",
  "settings": [
    { "type": "text", "id": "trigger_label", "label": "Button label", "default": "See your free product" },
    { "type": "text", "id": "heading", "label": "Popup heading", "default": "A free product for you" },
    { "type": "textarea", "id": "message", "label": "Message", "default": "Discover the free product included with your offer." },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "link_label", "label": "Product link label", "default": "View product" },
    { "type": "image_picker", "id": "image", "label": "Popup image" },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [
    { "name": "Free product popup" }
  ],
  "tag": null,
  "class": "free-product-popup-block"
}
{% endschema %}